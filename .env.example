# ============================================================
# Libras AI — variáveis de ambiente (backend: apps/api)
# Copie para .env e ajuste. NUNCA versione o .env real.
# ============================================================

# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# URL pública usada pelo backend para gerar links de animação (proxy do vídeo)
PUBLIC_BASE_URL=http://localhost:3000

# --- VLibras (prova de conceito executada em 20-10-2026) --------------------
# Tradução PT -> glosa: FUNCIONA sem autenticação (POST JSON {"text"}).
VLIBRAS_TRANSLATE_URL=https://traducao2.vlibras.gov.br/translate
# Dicionário oficial de sinais (trie ~3,6 MB) — valida tokens da glosa.
VLIBRAS_DICTIONARY_URL=https://dicionario2-dth.vlibras.gov.br/signs?version=2018.3.1
# Geração de vídeo do avatar: retorna 401 SEM credencial Conecta (OAuth).
# Sem token, o backend marca animationSource="simulation" e o app reproduz a
# simulação local. Com token, o fluxo real (POST /video -> status -> arquivo)
# é ativado automaticamente e servido via GET /api/animations/:id.
VLIBRAS_VIDEO_BASE_URL=https://traducao2.vlibras.gov.br
VLIBRAS_API_TOKEN=

# --- Transcrição de voz -----------------------------------------------------
# mock   -> simulado, sem chaves (padrão do MVP; ideal para demonstração)
# gemini -> transcrição real de áudio (exige GEMINI_API_KEY)
SPEECH_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Em desenvolvimento, se o provider real falhar, cai para o mock
SPEECH_FALLBACK_MOCK=true

# --- Filas (§6) -------------------------------------------------------------
# Sequencial por sessão; a concorrência vale entre sessões
QUEUE_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=2
QUEUE_MAX_PENDING_PER_SESSION=10

# --- Sessões, timeouts e limites -------------------------------------------
SESSION_TTL_MS=3600000
TRANSLATE_TIMEOUT_MS=10000
VIDEO_POLL_TIMEOUT_MS=15000
RATE_LIMIT_MAX=300

# ------------------------------------------------------------
# App mobile (apps/mobile) — variáveis Expo (prefixedadas)
# ------------------------------------------------------------
# URL do backend para o app (emulador Android usa 10.0.2.2 por padrão)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
